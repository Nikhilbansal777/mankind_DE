<worksheet name="Daily Views Trend">
  <layout-options><title><formatted-text><run bold='true' fontsize='11'>Daily Product Views — Campaign vs Organic Traffic</run></formatted-text></title></layout-options>
  <table>
    <view>
      <datasources><datasource caption='Campaign Views' name='federated.0campaignviews0000000000' /></datasources>
      <datasource-dependencies datasource='federated.0campaignviews0000000000'>
        <column caption="View Id" datatype='integer' name='[view_id]' role='dimension' type='ordinal' />
<column caption="View Timestamp" datatype='datetime' name='[view_ts]' role='dimension' type='ordinal' />
<column caption="View Date" datatype='date' name='[view_date]' role='dimension' type='ordinal' />
<column caption="User Id" datatype='integer' name='[user_id]' role='dimension' type='ordinal' />
<column caption="Product Id" datatype='integer' name='[product_id]' role='dimension' type='ordinal' />
<column caption="Category" datatype='string' name='[category]' role='dimension' type='nominal' />
<column caption="Traffic Source" datatype='string' name='[traffic_source]' role='dimension' type='nominal' />
<column caption="Attributed Campaign Id" datatype='integer' name='[campaign_id]' role='dimension' type='ordinal' />
<column caption="Is Campaign View" datatype='integer' name='[is_campaign_view]' role='measure' type='quantitative' />
<column caption="Added To Cart" datatype='integer' name='[added_to_cart]' role='measure' type='quantitative' />
<column caption="Purchased" datatype='integer' name='[purchased]' role='measure' type='quantitative' />
<column caption="Period Campaign Id" datatype='integer' name='[period_campaign_id]' role='dimension' type='ordinal' />
<column caption="Campaign Period" datatype='string' name='[campaign_period]' role='dimension' type='nominal' />
<column caption="Product Name" datatype='string' name='[product_name]' role='dimension' type='nominal' />
<column caption="Brand" datatype='string' name='[brand]' role='dimension' type='nominal' />
<column caption="Price" datatype='real' name='[price]' role='measure' type='quantitative' />
<column caption="Campaign Name" datatype='string' name='[campaign_name]' role='dimension' type='nominal' />
<column caption="Channel" datatype='string' name='[channel]' role='dimension' type='nominal' />
<column caption="Duration Days" datatype='real' name='[duration_days]' role='measure' type='quantitative' />
<column caption="Views" datatype='integer' default-format="n#,##0" name='[Calculation_1000000000000000001]' role='measure' type='quantitative'><calculation class='tableau' formula="COUNT([view_id])" /></column>
<column caption="Campaign View Share" datatype='real' default-format="p0.0%" name='[Calculation_1000000000000000002]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([is_campaign_view]) / COUNT([view_id])" /></column>
<column caption="Add to Cart Rate" datatype='real' default-format="p0.00%" name='[Calculation_1000000000000000003]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([added_to_cart]) / COUNT([view_id])" /></column>
<column caption="Purchase Rate" datatype='real' default-format="p0.00%" name='[Calculation_1000000000000000004]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([purchased]) / COUNT([view_id])" /></column>
<column caption="Traffic Type" datatype='string' name='[Calculation_1000000000000000005]' role='dimension' type='nominal'><calculation class='tableau' formula='IF [is_campaign_view] = 1 THEN "Campaign" ELSE "Organic" END' /></column>
<column caption="Revenue" datatype='real' default-format='c"$"#,##0' name='[Calculation_1000000000000000006]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM(IF [purchased] = 1 THEN [price] END)" /></column>
        <column-instance column='[Calculation_1000000000000000001]' derivation='User' name='[usr:Calculation_1000000000000000001:qk]' pivot='key' type='quantitative' />
<column-instance column='[view_date]' derivation='Day-Trunc' name='[tdy:view_date:qk]' pivot='key' type='quantitative' />
<column-instance column='[Calculation_1000000000000000005]' derivation='None' name='[none:Calculation_1000000000000000005:nk]' pivot='key' type='nominal' />
<column-instance column='[category]' derivation='None' name='[none:category:nk]' pivot='key' type='nominal' />
      </datasource-dependencies>
      <filter class='categorical' column='[federated.0campaignviews0000000000].[none:category:nk]'><groupfilter function='level-members' level='[none:category:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' /></filter>
      
      <slices><column>[federated.0campaignviews0000000000].[none:category:nk]</column></slices>
      <aggregation value='true' />
    </view>
    <style />
    <panes>
      <pane selection-relaxation-option='selection-relaxation-allow'>
        <view><breakdown value='auto' /></view>
        <mark class='Area' />
        <encodings><color column='[federated.0campaignviews0000000000].[none:Calculation_1000000000000000005:nk]' /></encodings>
      </pane>
    </panes>
    <rows>[federated.0campaignviews0000000000].[usr:Calculation_1000000000000000001:qk]</rows>
    <cols>[federated.0campaignviews0000000000].[tdy:view_date:qk]</cols>
  </table>
