<column caption="Budget (USD)" datatype='integer' name='[budget_usd]' role='measure' type='quantitative' />
<column caption="Baseline Avg Daily Views" datatype='real' name='[baseline_avg_daily_views]' role='measure' type='quantitative' />
<column caption="Campaign Avg Daily Views" datatype='real' name='[campaign_avg_daily_views]' role='measure' type='quantitative' />
<column caption="View Lift Pct" datatype='real' name='[view_lift_pct]' role='measure' type='quantitative' />
