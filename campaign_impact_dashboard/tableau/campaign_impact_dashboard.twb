<column caption="View Lift %" datatype='real' default-format="p0.0%" name='[Calculation_2000000000000000001]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([campaign_avg_daily_views]) / SUM([baseline_avg_daily_views]) - 1" /></column>
<column caption="Avg Lift % (KPI)" datatype='real' default-format="p0.0%" name='[Calculation_2000000000000000002]' role='measure' type='quantitative'><calculation class='tableau' formula="AVG([view_lift_pct]) / 100" /></column>
<column caption="Total Incremental Views (KPI)" datatype='integer' default-format="n#,##0" name='[Calculation_2000000000000000003]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([incremental_views])" /></column>
<column caption="Cost per Incremental View (KPI)" datatype='real' default-format='c"$"#,##0.00' name='[Calculation_2000000000000000004]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([budget_usd]) / SUM([incremental_views])" /></column>
<column caption="ROAS (KPI)" datatype='real' default-format='n#,##0.00"x"' name='[Calculation_2000000000000000005]' role='measure' type='quantitative'><calculation class='tableau' formula="SUM([attributed_revenue_usd]) / SUM([budget_usd])" /></column>
